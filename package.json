{
  "name": "oxill-calendar",
  "version": "1.7.1",
  "description": "Obsidian calendar for periodic notes, recurring schedules and day statuses",
  "repository": "https://github.com/oxilldat/oxill-calendar",
  "keywords": [
    "obsidian",
    "calendar",
    "daily-notes",
    "weekly-notes",
    "schedule",
    "shift-work",
    "status-tracker"
  ],
  "author": "Oxill",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "check": "tsc --noEmit --skipLibCheck",
    "build": "npm run check && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "obsidian": "1.14.4",
    "typescript": "7.0.2"
  }
}
